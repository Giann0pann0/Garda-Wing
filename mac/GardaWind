#!/bin/bash
# Avvio di Garda Wind. Nessuna dipendenza esterna: usa il Python di sistema.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RES="$(cd "$HERE/../Resources" && pwd)"
SUPPORT="$HOME/Library/Application Support/Garda Wind"
mkdir -p "$SUPPORT"
LOG="$SUPPORT/avvio.log"
PORT=8781
URL="http://127.0.0.1:$PORT/"

PY=""
for cand in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 "$(command -v python3 2>/dev/null)"; do
  if [ -n "$cand" ] && [ -x "$cand" ]; then PY="$cand"; break; fi
done
if [ -z "$PY" ]; then
  osascript -e 'display alert "Python 3 non trovato" message "Apri il Terminale e lancia: xcode-select --install"' >/dev/null 2>&1
  exit 1
fi

# Se e' gia' in ascolto, riapri solo il browser invece di avviare un secondo processo.
if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  open "$URL"
  exit 0
fi

cd "$RES"
"$PY" -m gardawind --port "$PORT" --no-browser >>"$LOG" 2>&1 &
SERVER=$!

# Aspetta che il server risponda davvero prima di aprire il browser: aprirlo
# subito darebbe una pagina di errore, e l'utente penserebbe che non funzioni.
for _ in $(seq 1 40); do
  if curl -fsS --max-time 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
    open "$URL"
    break
  fi
  sleep 0.5
done

if ! curl -fsS --max-time 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  osascript -e "display alert \"Garda Wind non e' partita\" message \"Guarda il file avvio.log in: $SUPPORT\"" >/dev/null 2>&1
fi

wait "$SERVER"
